// PicoCalc HDMI Mirror — vincoli base: clock, tasto, LED e HDMI (da J20K, provati sulla scheda)
//
// La SDRAM del GW2AR-18 sta DENTRO il package e non ha pin da vincolare: e' il
// motivo per cui questo file, che pure porta l'HDMI, e' piu' corto di quanto
// ci si aspetti da una scheda con memoria esterna.
//
// I QUATTRO IO_LOC DELL'HDMI HANNO DUE NUMERI CIASCUNO. E' la forma accoppiata
// di Gowin: si dichiara il solo segnale _p e lo strumento lega il _n al
// secondo pin, a patto che ENTRAMBI compaiano nel modulo di livello alto. Se
// il _n non c'e', la coppia resta muta e nessuno protesta.
//
// I pin vengono da un progetto HDMI gia' provato su questa stessa scheda, non
// da un foglio di calcolo.

// clock 27 MHz
IO_LOC  "sys_clk" 4;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// tasto
IO_LOC  "s1" 88;
IO_PORT "s1" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// LED, attivi bassi
IO_LOC  "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8;

// HDMI TMDS — canale 0 blu, 1 verde, 2 rosso, piu' il clock
IO_LOC  "tmds_clk_p" 33,34;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8;

IO_LOC  "tmds_d_p[0]" 35,36;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8;

IO_LOC  "tmds_d_p[1]" 37,38;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8;

IO_LOC  "tmds_d_p[2]" 39,40;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8;
