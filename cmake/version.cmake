# version.cmake — writes shell_version.h from `git describe`, for the banner
# (design.md §10, M0); copied from pico-oric. Run at build time, not
# configure time, since a configure-time value goes stale at the next
# commit. The header is rewritten only when the text changes, so an
# unchanged tree does not rebuild what includes it.
#
# Only tags of three numbers (v1.0.0, v0.2.0-beta) count: this repository also
# holds picocalc-shell's v1.0 to v1.3, which are not this program's versions.
#
#   cmake -DSRC=<source dir> -DOUT=<header> -P version.cmake

execute_process(
    COMMAND git describe --always --dirty --match v[0-9]*.[0-9]*.[0-9]*
    WORKING_DIRECTORY ${SRC}
    OUTPUT_VARIABLE version
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE result
)
if (NOT result EQUAL 0 OR version STREQUAL "")
    set(version "unknown")
endif()

set(text "/* Generated by cmake/version.cmake at build time. */\n#define SHELL_VERSION \"${version}\"\n")
set(old "")
if (EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if (NOT old STREQUAL text)
    file(WRITE ${OUT} "${text}")
endif()
